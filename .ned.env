# NedMedia project identity. Source this; do not retype the value anywhere.
#
#   set -a && . ./.ned.env && set +a
#
# This repo is NedMedia's fork of DDVTECH/mistserver; its builds serve the
# livestream-v2 (Airstream) stack, so issues from here file against that
# Linear project. There is no IaC in this repo today, so `projectname` is only
# the identifier for tags/secret paths if any are ever created from here.

projectname=mistserver
reponame=mediatique-press/mistserver
linear_project_id=d2039378-be35-4e0f-88ee-91b312b87d8b   # livestream v2
