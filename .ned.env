# NedMedia project identity. Source this; do not retype the value anywhere.
#
#   set -a && . ./.ned.env && set +a
#
# This is the NedMedia fork of DDVTECH MistServer: source patches and the
# Docker image build (nedmedia/mistserver). It owns no AWS resources of its
# own today; `projectname` is kept for the Project tag / OpenBao path should
# that change. Issues from this repo are filed against the Airstream project,
# the product the fork serves, with the repo:mediatique-press/mistserver label.

projectname=mistserver
reponame=mediatique-press/mistserver
linear_project_id=d2039378-be35-4e0f-88ee-91b312b87d8b   # Airstream Live Video Ingest & Delivery Stack ("livestream v2")
